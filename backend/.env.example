# Copia este archivo a .env y ajusta los valores.
# Genera una SECRET_KEY con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Mexico_City

# --- Base de datos ---------------------------------------------------------
# sqlite (default, no requiere nada más) o postgresql
DB_ENGINE=sqlite
# DB_NAME=academia
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Front-end -------------------------------------------------------------
# En DEBUG=True se permite cualquier origen. En producción, lista los tuyos.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base del frontend, para armar ligas dentro de los correos (comprobantes,
# avisos, recordatorios de pago).
FRONTEND_URL=http://localhost:4200

# --- Correo (avisos, recordatorios de pago, comprobantes) -------------------
# En DEBUG=True el backend de consola imprime los correos en la terminal;
# no hace falta configurar nada más para desarrollar.
#
# Opción A — 587/STARTTLS (la más común):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=cuenta@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# DEFAULT_FROM_EMAIL=Casa Brava <no-responder@casabrava.com>
#
# Opción B — 465/SSL (usa esta si tu red bloquea el handshake de STARTTLS en
# 587 — el síntoma es que el TCP conecta pero nunca llega el saludo del SMTP
# y la petición se queda colgada hasta EMAIL_TIMEOUT):
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_PORT=465
#
# EMAIL_TIMEOUT=15

# Origen(es) del frontend para el chequeo de CSRF (aplica también en DEBUG=True).
# Por defecto ya incluye http://localhost:4200 (ng serve).
# CSRF_TRUSTED_ORIGINS=http://localhost:4200

# --- Stripe (pagos en línea) ------------------------------------------------
# Llaves en https://dashboard.stripe.com/apikeys. En desarrollo usa las sk_test_
# y el whsec_ que imprime `stripe listen --forward-to localhost:8000/api/payments/webhook/stripe/`.
# NUNCA subas estas llaves a Git ni las pongas en el frontend.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
# STRIPE_CURRENCY=mxn
# Mínimo que Stripe acepta por cobro en esa moneda (MXN: 10.00).
# STRIPE_MONTO_MINIMO=10.00
# STRIPE_SUCCESS_URL=http://localhost:4200/payment/success
# STRIPE_CANCEL_URL=http://localhost:4200/payment/cancel
# THROTTLE_CHECKOUT=10/min

# --- Solo producción (DEBUG=False) -----------------------------------------
# CSRF_TRUSTED_ORIGINS=https://academia.com,https://www.academia.com
# SECURE_SSL_REDIRECT=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
